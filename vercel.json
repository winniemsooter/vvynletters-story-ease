{
  "functions": {
    "api/meta-tags.js": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/blog/:slug",
      "destination": "/api/meta-tags?slug=:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(bot|crawler|spider|facebookexternalhit|twitterbot|linkedinbot|whatsapp|telegrambot|skypeuripreview|slackbot|discordbot).*"
        }
      ]
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}